{
  "project_analysis": {
    "project_name": "Fleet Management System",
    "framework": "Laravel 12",
    "php_version": "^8.2",
    "analysis_date": "2025-02-11",
    "overview": {
      "type": "Multi-tenant Fleet Management & Logistics System",
      "description": "A comprehensive fleet management application with consignment tracking, vehicle monitoring, driver management, and franchise-based multi-tenancy. The system supports full consignment lifecycle management from booking to delivery with PDF invoice generation, POD management, and trip status tracking.",
      "architecture": "MVC (Model-View-Controller) with session-based franchise isolation",
      "multi_tenancy": "Franchise-based data segregation using session filtering"
    },
    "technology_stack": {
      "backend": {
        "framework": "Laravel 12.0",
        "php": "^8.2",
        "packages": [
          "laravel/framework:^12.0",
          "laravel/sanctum:^4.0",
          "laravel/ui:^4.6",
          "barryvdh/laravel-dompdf:^3.1"
        ]
      },
      "frontend": {
        "css": "TailwindCSS 4.0 + Bootstrap 5.2.3",
        "javascript": "ES6 Modules with Vite",
        "build_tool": "Vite 7.0.7",
        "icons": "Font Awesome (via Bootstrap)"
      },
      "database": {
        "default": "MySQL",
        "migrations": "Laravel Migrations",
        "seeding": "Database Seeders"
      },
      "authentication": {
        "primary": "Laravel Session-based (web guard)",
        "api": "Laravel Sanctum",
        "guards": [
          "web (users)",
          "customer (sanctum)",
          "driver (sanctum)"
        ]
      }
    },
    "database_schema": {
      "core_tables": [
        {
          "name": "users",
          "purpose": "Admin users, team members, and system users",
          "key_columns": [
            "id",
            "email",
            "password",
            "role_id (FK)",
            "franchise_id (FK, nullable for super admin)",
            "department",
            "position",
            "status",
            "profile_image"
          ],
          "relationships": {
            "belongsTo": ["Role", "Franchise"]
          }
        },
        {
          "name": "roles",
          "purpose": "User role definitions (admin, manager, staff, etc.)",
          "key_columns": ["id", "name", "slug", "description", "is_active"]
        },
        {
          "name": "franchises",
          "purpose": "Franchise data (UAE, Qatar, Saudi Arabia)",
          "key_columns": [
            "id",
            "country_name",
            "currency",
            "has_tax",
            "tax_percentage",
            "is_active"
          ],
          "note": "Maximum 3 franchises allowed (enforced in FranchiseController)"
        },
        {
          "name": "transports",
          "purpose": "Consignment/Transport records (main entity)",
          "key_columns": [
            "id",
            "order_no (auto-generated with franchise prefix)",
            "franchise_id (FK)",
            "customer_id (FK)",
            "consignment_type",
            "consigner",
            "pickup_location",
            "source_pincode",
            "source_city",
            "source_state",
            "source_country",
            "delivery_location",
            "dest_pincode",
            "dest_state",
            "dest_country",
            "pickup_datetime",
            "delivery_date",
            "receiver_name",
            "receiver_mobile",
            "party_lr_no",
            "packages",
            "weight",
            "invoice_no",
            "invoice_value",
            "trip_type (FTL/LTL/Express)",
            "vehicle_type",
            "assigned_vehicle_no",
            "assigned_driver",
            "assigned_driver_id",
            "handling_instructions",
            "third_party_name",
            "third_party_vehicle",
            "freight_weight",
            "weight_unit",
            "rate_per_unit",
            "total_packages",
            "rate_per_package",
            "fixed_cost",
            "expense_types (JSON array)",
            "expense_amounts (JSON array)",
            "expense_remarks (JSON array)",
            "final_notes",
            "status (draft/assigned/confirmed/in_transit/delivered/cancelled)",
            "total_cost",
            "total_distance",
            "total_travel_time"
          ],
          "relationships": {
            "belongsTo": ["Franchise", "Customer"]
          },
          "auto_generation": "order_no format: {FRANCHISE_CODE}-TR{001-999}"
        },
        {
          "name": "customers",
          "purpose": "Customer information",
          "key_columns": [
            "id",
            "name",
            "address",
            "mobile_no",
            "email (unique)",
            "password (hashed, nullable)",
            "photo"
          ]
        },
        {
          "name": "vehicles",
          "purpose": "Vehicle fleet management",
          "key_columns": [
            "id",
            "brand",
            "model",
            "vehicle_number (unique)",
            "purchase_date",
            "registration_year",
            "color",
            "fuel_type",
            "average",
            "max_weight",
            "current_odometer",
            "insurance_valid_till",
            "puc_expiry",
            "vehicle_type",
            "status (available/not_available/assigned)",
            "driver_id (FK, nullable)",
            "image_path",
            "documents_path"
          ],
          "relationships": {
            "belongsTo": ["DrivingTeam as driver"]
          }
        },
        {
          "name": "drivers",
          "purpose": "Driver master data (separate from driving_teams)",
          "key_columns": [
            "id",
            "driver_id (unique identifier)",
            "name",
            "blood_group",
            "phone",
            "emergency_phone",
            "address",
            "license_number",
            "license_expiry",
            "license_type",
            "total_trips",
            "experience_years",
            "status",
            "avatar_path"
          ]
        },
        {
          "name": "driving_teams",
          "purpose": "Active driving team assignments",
          "key_columns": [
            "id",
            "name",
            "driver_id",
            "phone_number",
            "emergency_number",
            "address",
            "blood_group",
            "license_number",
            "license_expiry",
            "license_type",
            "experience",
            "driver_photo",
            "license_photo",
            "status",
            "kyc_status"
          ],
          "relationships": {
            "hasMany": ["Vehicles"]
          }
        },
        {
          "name": "pods",
          "purpose": "Proof of Delivery documents",
          "key_columns": [
            "id",
            "transport_id (FK, cascade delete)",
            "file_name",
            "original_name",
            "file_path",
            "file_type",
            "file_size",
            "description"
          ]
        },
        {
          "name": "geographies",
          "purpose": "Countries/Regions",
          "key_columns": [
            "id",
            "name",
            "code (unique)",
            "currency",
            "region",
            "description",
            "status",
            "created_by (FK to users)",
            "updated_by (FK to users)"
          ],
          "relationships": {
            "hasMany": ["Cities", "Hubs"]
          }
        },
        {
          "name": "cities",
          "purpose": "City data",
          "key_columns": [
            "id",
            "name",
            "country_id (FK)",
            "hub_id (FK, nullable)",
            "status",
            "postal_code",
            "latitude",
            "longitude",
            "timezone",
            "created_by",
            "updated_by"
          ]
        },
        {
          "name": "hubs",
          "purpose": "Logistics hubs",
          "key_columns": [
            "id",
            "name",
            "country_id (FK)",
            "city_id (FK, nullable)",
            "code (unique)",
            "address",
            "contact_person",
            "contact_number",
            "status"
          ]
        },
        {
          "name": "brands",
          "purpose": "Vehicle brands",
          "key_columns": [
            "id",
            "name",
            "slug (unique)",
            "is_active",
            "logo"
          ]
        },
        {
          "name": "cargo_types",
          "purpose": "Cargo/Goods types",
          "key_columns": [
            "id",
            "title",
            "description",
            "image"
          ]
        }
      ],
      "additional_tables": [
        "team_members (minimal, only id and timestamps)",
        "billing_entities",
        "peak_accounts",
        "tyres",
        "fleets",
        "expenses",
        "attendances",
        "performance_reports",
        "admin_panels",
        "utility_tools",
        "help_centers",
        "my_assistances",
        "personal_access_tokens (sanctum)"
      ]
    },
    "key_models": {
      "Transport": {
        "file": "app/Models/Transport.php",
        "fillable": [
          "order_no",
          "franchise_id",
          "customer_id",
          "consignment_type",
          "consigner",
          "pickup_location",
          "source_pincode",
          "source_city",
          "source_state",
          "source_country",
          "source_building_no",
          "source_maps_link",
          "delivery_location",
          "address_line",
          "building_no",
          "dest_pincode",
          "dest_state",
          "dest_country",
          "dest_building_no",
          "dest_maps_link",
          "pickup_datetime",
          "delivery_date",
          "receiver_name",
          "receiver_mobile",
          "party_lr_no",
          "packages",
          "weight",
          "invoice_no",
          "invoice_value",
          "trip_type",
          "vehicle_type",
          "assigned_vehicle_no",
          "assigned_driver",
          "assigned_driver_id",
          "handling_instructions",
          "third_party_name",
          "third_party_vehicle",
          "freight_weight",
          "weight_unit",
          "rate_per_unit",
          "total_packages",
          "rate_per_package",
          "fixed_cost",
          "expense_types",
          "expense_amounts",
          "expense_remarks",
          "final_notes",
          "status",
          "total_cost",
          "total_distance",
          "total_travel_time"
        ],
        "casts": {
          "pickup_datetime": "datetime",
          "delivery_date": "date",
          "expense_types": "array",
          "expense_amounts": "array",
          "expense_remarks": "array"
        },
        "relationships": {
          "belongsTo": ["Customer", "Franchise"]
        },
        "boot_method": "Auto-generates order_no on creating using generateOrderNo()",
        "order_number_format": "{FRANCHISE_CODE}-TR{001-999} (e.g., UAE-TR001, QTR-TR001)"
      },
      "User": {
        "file": "app/Models/User.php",
        "fillable": [
          "name",
          "email",
          "password",
          "mobile",
          "role_id",
          "franchise_id",
          "department",
          "position",
          "date_of_joining",
          "status",
          "profile_image"
        ],
        "hidden": ["password", "remember_token"],
        "casts": {
          "email_verified_at": "datetime",
          "password": "hashed",
          "date_of_joining": "date"
        },
        "relationships": {
          "belongsTo": ["Role", "Franchise"]
        },
        "access_control": "Super admin has null franchise_id and can access all franchises"
      },
      "Franchise": {
        "file": "app/Models/Franchise.php",
        "fillable": [
          "country_name",
          "currency",
          "has_tax",
          "tax_percentage",
          "is_active"
        ],
        "casts": {
          "has_tax": "boolean",
          "is_active": "boolean",
          "tax_percentage": "decimal:2"
        }
      },
      "Vehicle": {
        "file": "app/Models/Vehicle.php",
        "fillable": [
          "brand",
          "model",
          "vehicle_number",
          "purchase_date",
          "registration_year",
          "color",
          "fuel_type",
          "average",
          "max_weight",
          "current_odometer",
          "insurance_valid_till",
          "puc_expiry",
          "vehicle_type",
          "status",
          "driver_id",
          "image_path",
          "documents_path"
        ],
        "relationships": {
          "belongsTo": ["DrivingTeam as driver"]
        }
      },
      "Customer": {
        "file": "app/Models/Customer.php",
        "fillable": [
          "name",
          "address",
          "mobile_no",
          "email",
          "password",
          "photo"
        ],
        "hidden": ["password"],
        "uses": "HasApiTokens for customer API authentication"
      },
      "Pod": {
        "file": "app/Models/Pod.php",
        "fillable": [
          "transport_id",
          "file_name",
          "original_name",
          "file_path"
        ],
        "relationships": {
          "belongsTo": ["Transport"]
        }
      }
    },
    "authentication_authorization": {
      "multi_tenant": true,
      "franchise_isolation": "Session-based with franchise_id filtering",
      "login_flow": {
        "step1": "Select franchise from public page (franchises.index)",
        "step2": "Franchise ID stored in session (selected_franchise_id)",
        "step3": "Login with credentials",
        "step4": "Validate user belongs to selected franchise",
        "step5": "Store franchise_id in session for data filtering"
      },
      "super_admin": {
        "identification": "franchise_id = null OR role_id = 1",
        "access": "Can access any franchise data",
        "session_handling": "Uses selected_franchise_id from session"
      },
      "guards": {
        "web": "Session-based for admin users",
        "customer": "Sanctum token-based for customer portal",
        "driver": "Sanctum token-based for driver app"
      },
      "middleware": [
        "auth (standard Laravel)",
        "auth.customer (custom for customer guard)"
      ]
    },
    "business_features": {
      "consignment_management": {
        "module": "New Consignment (Multi-step Wizard)",
        "controller": "NewConsignmentController",
        "steps": [
          {
            "step": 1,
            "name": "Route & Parties",
            "route": "admin.new-consignment.create",
            "fields": [
              "consigner",
              "pickup_location",
              "source_pincode",
              "source_city",
              "source_state",
              "source_country",
              "source_building_no",
              "source_maps_link",
              "delivery_location",
              "address_line",
              "building_no",
              "dest_pincode",
              "dest_state",
              "dest_country",
              "dest_building_no",
              "dest_maps_link",
              "pickup_datetime",
              "delivery_date",
              "receiver_name",
              "receiver_mobile"
            ],
            "status_after": "draft"
          },
          {
            "step": 2,
            "name": "Freight Assignment",
            "route": "admin.freight-assignment.index",
            "fields": [
              "party_lr_no",
              "packages",
              "weight",
              "invoice_no",
              "invoice_value",
              "trip_type (FTL/LTL/Express)",
              "vehicle_type",
              "assigned_vehicle_no",
              "assigned_driver",
              "assigned_driver_id",
              "handling_instructions",
              "third_party_name",
              "third_party_vehicle"
            ],
            "logic": "Vehicle availability check - FTL assigned vehicles hidden from selection",
            "status_after": "assigned"
          },
          {
            "step": 3,
            "name": "Charges & Advance",
            "route": "admin.charges-advance.index",
            "freight_options": [
              "Rate By Weight (freight_weight × rate_per_unit)",
              "Rate By Package (total_packages × rate_per_package)",
              "Fixed Rate (fixed_cost)"
            ],
            "expense_tracking": {
              "fields": ["expense_type[]", "expense_amount[]", "expense_remarks[]"],
              "storage": "JSON arrays in transports table"
            },
            "final_fields": ["final_notes", "confirm_booking (accepted)"],
            "calculation": "total_cost = freight_cost + sum(expenses)",
            "status_after": "confirmed"
          }
        ],
        "session_management": "transport_id stored in session between steps",
        "draft_handling": "Auto-detects and continues existing draft on create"
      },
      "consignment_listing": {
        "controller": "ConsignmentController",
        "features": [
          "List all consignments (including drafts)",
          "Franchise-filtered view",
          "View details with vehicle and driver info",
          "Edit redirects to appropriate step based on status",
          "Delete with franchise isolation",
          "Generate PDF invoice"
        ]
      },
      "trip_status_tracking": {
        "controller": "TripStatusController",
        "statuses": ["draft", "assigned", "confirmed", "in_transit", "delivered", "cancelled"],
        "features": [
          "View all trips with timeline",
          "Edit trip status with reason",
          "Timeline auto-generated from transport data",
          "Delivery date auto-set on 'delivered' status"
        ]
      },
      "pod_management": {
        "controller": "PodController",
        "features": [
          "Upload multiple POD files per transport",
          "File types: images, PDFs, documents",
          "Storage: public/pod/{transport_id}/",
          "View and download PODs",
          "Delete with file cleanup"
        ]
      },
      "invoice_generation": {
        "controllers": ["ConsignmentController", "InvoiceController"],
        "format": "PDF using DomPDF",
        "invoice_number": "INV/{FRANCHISE_CODE}/{PADDED_ID} (e.g., INV/UAE/00001)",
        "includes": [
          "Consignment details",
          "Freight charges",
          "Expense breakdown",
          "Total cost",
          "Franchise-specific formatting"
        ]
      },
      "customer_management": {
        "controller": "CustomerController",
        "features": [
          "CRUD operations",
          "Photo upload",
          "Password hashing (optional)",
          "Search by name, email, mobile"
        ]
      },
      "vehicle_monitoring": {
        "controller": "VehicleMonitoringController",
        "features": [
          "Vehicle CRUD with file uploads (photo, documents)",
          "Brand-based grouping",
          "Driver assignment",
          "Status management (available/not_available)",
          "Vehicle details view"
        ]
      },
      "driver_management": {
        "models": ["Driver", "DrivingTeam"],
        "features": [
          "Driver master data (Driver model)",
          "Driving team assignments (DrivingTeam model)",
          "KYC status tracking",
          "License management with expiry",
          "Photo uploads"
        ]
      },
      "geography_management": {
        "controller": "GeographyController",
        "entities": ["Countries (Geographies)", "Cities", "Hubs"],
        "features": [
          "CRUD for all three entity types",
          "Hierarchical structure: Country → City → Hub",
          "Status toggling via AJAX",
          "Dependent dropdowns (cities by country, hubs by country)",
          "Latitude/longitude for cities"
        ]
      },
      "brand_management": {
        "controller": "BrandController",
        "purpose": "Vehicle brand catalog with logo support"
      },
      "cargo_type_management": {
        "controller": "cargoController",
        "purpose": "Cargo types catalog with images"
      }
    },
